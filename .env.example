# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Required (chat / ask / cofounder) ────────────────────────
# Get your key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_key_here
OLLAMA_CHAT_MODEL=deepseek-v4-flash:cloud

# ── Embeddings (search + index) ──────────────────────────────
# fastembed = local ONNX model, no API key (recommended)
EMBED_BACKEND=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional: use local Ollama for embeddings instead
# EMBED_BACKEND=ollama
# OLLAMA_EMBED_HOST=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: Ollama chat host (default https://ollama.com)
# OLLAMA_HOST=https://ollama.com

# Optional: protect the web API (Bearer token). Leave empty for local-only dev.
HORMOZI_WEB_TOKEN=

# Optional: override data paths (local dev or custom mounts)
# HORMOZI_VAULT_DIR=/data/hormozi-brain
# HORMOZI_INDEX_DIR=/data/hormozi-index

# Optional: extra CORS origins (comma-separated). Vercel URLs match by default.
# CORS_ORIGINS=https://my-app.vercel.app
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Split deploy (recommended) ─────────────────────────────────
# Render API:  https://hormozi-s-transcripts.onrender.com
# Set on Render: OLLAMA_API_KEY, EMBED_BACKEND=fastembed, HORMOZI_WEB_TOKEN
#
# After changing embed backend/model, rebuild the index:
#   python tools/build_index.py --rebuild
