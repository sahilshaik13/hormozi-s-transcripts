# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Required ─────────────────────────────────────────────────
GEMINI_API_KEY=your_key_here

# Optional: protect the web API (Bearer token). Leave empty for local-only dev.
HORMOZI_WEB_TOKEN=

# Optional: override data paths (local dev or custom mounts)
# HORMOZI_VAULT_DIR=/data/hormozi-brain
# HORMOZI_INDEX_DIR=/data/hormozi-index

# Optional: extra CORS origins (comma-separated). Vercel URLs match by default.
# CORS_ORIGINS=https://my-app.vercel.app
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Vercel (set in Project → Settings → Environment Variables) ─
# GEMINI_API_KEY=...
# HORMOZI_WEB_TOKEN=...          (optional auth)
# VITE_HORMOZI_WEB_TOKEN=...       (optional: auto-fill token in UI at build time)

# Deploy note: hormozi-brain/ and hormozi-index/ must be present when you deploy.
# They are gitignored locally; use `vercel deploy` from your machine, or a private
# repo branch that includes them, or Vercel CLI with --archive.
#
# Hobby plan limits: 2048 MB RAM, 10s function timeout per request.
# /api/ask may timeout on Hobby — upgrade to Pro for 60–300s and more memory.
#
# Vercel bundle limit (~245 MB): this app is ~356 MB with ChromaDB + vault + index.
# Use Render instead — see render.yaml + Dockerfile (Starter plan ~$7/mo).
