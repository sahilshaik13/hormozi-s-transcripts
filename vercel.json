{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix web && pip install -r requirements.txt",
  "buildCommand": "python vercel_build.py",
  "functions": {
    "app.py": {
      "maxDuration": 120,
      "memory": 3008,
      "includeFiles": "{hormozi-index/**,hormozi-brain/**,backend/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
